# Copy to .env.local for `npm run dev` (comments only — the site gate needs `vercel dev`, see
# docs/comments-setup.md), and set the same names as environment variables in the Vercel project
# for production. Never commit the real values.

# --- Comments (giscus) --------------------------------------------------
# From giscus.app after connecting the repo. VITE_-prefixed so Vite exposes them to the client —
# none of these are secret; they only identify which repo/category comments are stored in.
VITE_GISCUS_REPO=annuai/ati-docs
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=Comments
VITE_GISCUS_CATEGORY_ID=

# --- Site access gate (middleware.js + api/login.js) --------------------
# SITE_PASSWORD is the shared passphrase people type in. SITE_ACCESS_SECRET signs the resulting
# cookie — a separate random string, not the passphrase itself. Both are server-only secrets:
# no VITE_ prefix, never shipped to the browser.
SITE_PASSWORD=
SITE_ACCESS_SECRET=
